.venv/
__pycache__/
data/
*.pt
output_hsv_test/
*.db

detection_accuracy.json

# Run outputs. output_soccernet* holds artefacts derived from SoccerNet
# frames, which are under a non-commercial NDA and must not be committed.
output_soccernet*/

# The shot test set: clips cut from SoccerNet match video, and the manifests
# naming them. Same NDA as above -- the clips are the footage itself, so they
# never enter the repository. The script that rebuilds them does.
shot_windows/
pass_threshold_sweep.json
merge_window_sweep.json
carry_threshold_sweep.json
output_veo/

# Training crops: four of five clips are SoccerNet, whose terms are
# non-commercial and no-redistribution. Nothing derived from them is
# committed; only fitted parameters ever leave this directory.
marking_crops/

# Weights trained on SoccerNet clips; the terms are non-commercial and
# no-redistribution, so the fitted model is as unshippable as the frames.
models/arc_without_*.pt
models/marking_without_*.pt
