.venv/
__pycache__/
data/
# data may be a link to footage elsewhere (src/paths.py); never commit it
/data
*.pt
output_hsv_test/
*.db

detection_accuracy.json

# Run outputs. output_soccernet* holds artefacts derived from SoccerNet
# frames, which are under a non-commercial NDA and must not be committed.
output_soccernet*/

# The goal-labelling page. It embeds SoccerNet frames, so it is the data
# itself and never enters the repository -- the generator does. The labels
# that come back are derived from those frames and stay out too.
goal_labeller.html
goal_labels.json
goal_dataset.json

# The YOLO dataset built from those labels, and the weights trained on it.
# Both are SoccerNet frames or derived from them, so neither is committed;
# the scripts that rebuild them are.
goal_yolo/
yolov8n.pt

# The same, for the windows cut around labelled shots: output_stoke_1302 and
# friends are the pipeline's artefacts from SoccerNet match video, so they
# are covered by the same NDA as anything else derived from those frames.
output_stoke*/
output_reading*/

# The shot test set: clips cut from SoccerNet match video, and the manifests
# naming them. Same NDA as above -- the clips are the footage itself, so they
# never enter the repository. The script that rebuilds them does.
shot_windows/
pass_threshold_sweep.json
merge_window_sweep.json
carry_threshold_sweep.json
output_veo/

# Training crops: four of five clips are SoccerNet, whose terms are
# non-commercial and no-redistribution. Nothing derived from them is
# committed; only fitted parameters ever leave this directory.
marking_crops/

# Weights trained on SoccerNet clips; the terms are non-commercial and
# no-redistribution, so the fitted model is as unshippable as the frames.
models/arc_without_*.pt
models/marking_without_*.pt
runs/
goal_corner_labeller.html
goal_corners.json
circle_labeller.html
circle_labels.json

# Intermediate results (src/paths.py CACHE_DIR)
.cache/
ball_labeller.html
ball_labeller2.html
ball_labels.json
